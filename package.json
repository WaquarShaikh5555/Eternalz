{
  "name": "Eternlz",
  "version": "1.1.0",
  "description": "A Professional Discord Bot with AI-powered server administration",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node index.js",
    "register": "node config/deploy-commands.js",
    "register:guild": "node config/deploy-commands.js --guild",
    "register:global": "node config/deploy-commands.js --global",
    "test": "node --test \"test/*.test.js\"",
    "check": "node --check index.js && node --check webserver.js && node --check config/deploy-commands.js",
    "verify": "npm run check && npm test",
    "test:watch": "node --test --watch \"test/*.test.js\""
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "@discordjs/voice": "^0.18.0",
    "@napi-rs/canvas": "^0.1.69",
    "axios": "^1.8.4",
    "cheerio": "^1.0.0",
    "discord.js": "^14.18.0",
    "dotenv": "^16.0.3",
    "express": "^5.1.0",
    "fetch": "^1.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "google-tts-api": "^2.0.2",
    "moment": "^2.30.1",
    "mongoose": "^8.13.2",
    "node-fetch": "^2.7.0",
    "openai": "^4.95.1"
  },
  "author": "Waquar Shaikh",
  "license": "ISC"
}
