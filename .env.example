# ---------------------------------------------------------------------------
# Eternalz - environment configuration
#
# Copy this file to `.env` for local development, or paste the values into the
# hosting panel's "Environment Variables" section (Wispbyte and similar).
#
# NEVER commit a filled-in copy of this file. `.env` is already ignored.
# ---------------------------------------------------------------------------

# --- Discord (required) ----------------------------------------------------
# The bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=
# The application id from the Developer Portal -> General Information
DISCORD_CLIENT_ID=
# The server id the AI administration is allowed to act on.
# Right-click the server -> Copy Server ID (enable Developer Mode first).
DISCORD_GUILD_ID=

# --- Optional: MongoDB -----------------------------------------------------
# Only needed if you use the optional database connection. The bot runs fine
# without it.
MONGO_URI=

# --- AI provider (required for /ai) ----------------------------------------
# Which provider to use: groq | openrouter | gemini | openai | custom
AI_PROVIDER=groq
# Overrides the default base URL for the provider (optional).
# AI_BASE_URL=https://api.groq.com/openai/v1
# The model id (optional - a sensible default is chosen per provider).
# AI_MODEL=openai/gpt-oss-120b
# The API key for the chosen provider.
AI_API_KEY=
# Optional fallback chain, comma separated: provider|baseUrl|model
# AI_FALLBACK_PROVIDERS=openrouter|https://openrouter.ai/api/v1|openrouter/free
# Request timeout in milliseconds (default 60000).
AI_TIMEOUT_MS=60000
# How many inspection rounds the model may run before it has to plan (default 1 for free-tier use).
AI_MAX_PLANNING_ROUNDS=1
# Maximum number of actions in a single plan (default 25).
AI_MAX_ACTIONS=25
# Maximum completion tokens per model call (default 512; keeps Groq free-tier requests small).
AI_MAX_OUTPUT_TOKENS=512

# --- AI administration access ------------------------------------------------
# Comma separated user ids that may use /ai in addition to the server owner.
AI_ADMIN_USER_IDS=
# Optional: let ONLY the configured user ids above use /ai in other servers
# where they are the owner or have Administrator / Manage Server (default false).
# Keep DISCORD_GUILD_ID set, and register /ai globally after enabling this.
AI_MULTI_GUILD=false
# Optional: role ids whose members may also use /ai in the primary server only.
AI_ADMIN_ROLE_IDS=
# Optional: a private channel that receives an audit trail of every action.
AI_AUDIT_CHANNEL_ID=
# How long a pending plan stays confirmable, in milliseconds (default 5 minutes).
AI_CONFIRM_TIMEOUT_MS=300000
# Minimum time between two /ai requests from the same user, in milliseconds.
AI_REQUEST_COOLDOWN_MS=10000

# --- Emergency switches -----------------------------------------------------
# Master switch for the AI administration commands. Set to false to turn /ai off
# completely without redeploying.
AI_ADMIN_ENABLED=true
# Set to false to keep the bot able to inspect and plan, but not to change
# anything. Everything else in the bot keeps working.
AI_WRITE_ENABLED=true

# --- Storage ----------------------------------------------------------------
# auto | sqlite | json
# `auto` uses the built-in node:sqlite module when the Node.js version supports
# it and falls back to a JSON file otherwise.
STORAGE_DRIVER=auto
# Where the SQLite database / JSON file is written.
DATA_DIR=./data

# --- Web server -------------------------------------------------------------
PORT=3000

# --- Logging ----------------------------------------------------------------
# error | warn | info | debug
LOG_LEVEL=info
